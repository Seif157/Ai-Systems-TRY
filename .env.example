APP_ENV=development
LOG_LEVEL=INFO

# Secret-manager supplied static routes; placeholders only, never public/model input.
ERP_AI_KNOWLEDGE_ROUTES_JSON=<customer-to-reader-publisher-migration-dsn-secret-map>

# Local PostgreSQL integration tests only. Never point this at customer or production data.
ERP_AI_TEST_ADMIN_DSN=<postgresql-admin-dsn-for-synthetic-test-service>
ERP_AI_REQUIRE_POSTGRES_TESTS=0

# Local Qwen3/TEI tests only. Supply a synthetic secret; never commit its value.
ERP_AI_REQUIRE_LOCAL_EMBEDDING_TESTS=0
ERP_AI_TEI_ENDPOINT=http://127.0.0.1:58080
ERP_AI_TEI_API_KEY=<synthetic-local-test-secret>
ERP_AI_EMBEDDING_CACHE_VOLUME=erp_ai_qwen3_embedding_cache
